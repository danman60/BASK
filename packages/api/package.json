{
  "name": "@bask/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "_comment": "'.' is SERVER-ONLY (it reaches the Prisma client). './roles' and './surfaces' are the client-safe subpaths the web/mobile UI imports at runtime.",
