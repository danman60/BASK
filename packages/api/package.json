    ".": "./src/index.ts",
    "./roles": "./src/roles.ts",
    "./surfaces": "./src/surfaces.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bask/core": "workspace:*",
    "@bask/db": "workspace:*",
    "@trpc/server": "^11.18.0",
    "superjson": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
