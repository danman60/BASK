# Copy to packages/db/.env and fill from ~/.env.keys (shared CC&SS Supabase project).
#
# Runtime queries only — pgbouncer TRANSACTION pooler (:6543).
# Prisma Migrate must NEVER use this URL: it takes a session-level advisory lock,
# which transaction-mode pooling cannot hold, so migrate commands hang forever.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=10&schema=bask"

# All DDL / migrations / introspection — SESSION pooler (:5432).
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=bask"
