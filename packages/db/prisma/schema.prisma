}

model DraftOrderLine {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draftOrderId        String   @map("draft_order_id") @db.Uuid
  productId           String?  @map("product_id") @db.Uuid
  uvaluxCatalogItemId String?  @map("uvalux_catalog_item_id") @db.Uuid
  description         String?
  quantity            Int      @default(1)
  unitPrice           Decimal  @default(0) @map("unit_price") @db.Decimal(10, 2)
  /// Why this line is on the order — shown to the rep in Compass.
  reason              String?
