  @@index([draftOrderId])
  @@map("draft_order_line")
  @@schema("bask")
}

// ---------------------------------------------------------------------------
// Compass (dealer side) — reads salon data only through packages/core/consent.ts
// ---------------------------------------------------------------------------

model Account {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId              String           @unique @map("salon_id") @db.Uuid
  accountNumber        String?          @unique @map("account_number")
  lifecycle            AccountLifecycle @default(established)
  healthScore          Int?             @map("health_score")
  annualWholesaleValue Decimal?         @map("annual_wholesale_value") @db.Decimal(12, 2)
  territory            String?
  assignedRepId        String?          @map("assigned_rep_id") @db.Uuid
  lastContactAt        DateTime?        @map("last_contact_at") @db.Timestamptz(6)
  nextTouchAt          DateTime?        @map("next_touch_at") @db.Timestamptz(6)
  metadata             Json             @default("{}")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon            Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  assignedRep      Staff?            @relation("AccountAssignedRep", fields: [assignedRepId], references: [id], onDelete: SetNull)
  signalSnapshots  SignalSnapshot[]
  coachingRequests CoachingRequest[]
  contactLogs      ContactLog[]
  draftOrders      DraftOrder[]

  @@index([lifecycle])
  @@index([assignedRepId])
  @@map("account")
  @@schema("bask")
}

model SignalSnapshot {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String          @map("account_id") @db.Uuid
  salonId    String          @map("salon_id") @db.Uuid
  signalType String          @map("signal_type")
  severity   InsightSeverity @default(medium)
  headline   String
  metrics    Json            @default("{}")
  evidence   Json            @default("{}")
  forDate    DateTime        @map("for_date") @db.Date
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  salon   Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([accountId, forDate])
  @@index([salonId])
  @@map("signal_snapshot")
  @@schema("bask")
}

model CoachingRequest {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId            String               @map("salon_id") @db.Uuid
  accountId          String               @map("account_id") @db.Uuid
  topic              String
  message            String?
  state              CoachingRequestState @default(open)
  requestedByStaffId String?              @map("requested_by_staff_id") @db.Uuid
  assignedRepId      String?              @map("assigned_rep_id") @db.Uuid
  response           String?
  requestedAt        DateTime             @default(now()) @map("requested_at") @db.Timestamptz(6)
  respondedAt        DateTime?            @map("responded_at") @db.Timestamptz(6)
  closedAt           DateTime?            @map("closed_at") @db.Timestamptz(6)

  salon       Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  account     Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  requestedBy Staff?  @relation("CoachingRequestedBy", fields: [requestedByStaffId], references: [id], onDelete: SetNull)
  assignedRep Staff?  @relation("CoachingAssignedRep", fields: [assignedRepId], references: [id], onDelete: SetNull)

  @@index([salonId, state])
  @@index([accountId, state])
  @@map("coaching_request")
  @@schema("bask")
}

model ContactLog {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId       String         @map("account_id") @db.Uuid
  salonId         String         @map("salon_id") @db.Uuid
  repId           String?        @map("rep_id") @db.Uuid
  channel         ContactChannel @default(call)
  outcome         String?
  notes           String?
  playbookKey     String?        @map("playbook_key")
  durationMinutes Int?           @map("duration_minutes")
  contactedAt     DateTime       @default(now()) @map("contacted_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  rep      Staff?    @relation(fields: [repId], references: [id], onDelete: SetNull)
  playbook Playbook? @relation(fields: [playbookKey], references: [key])

  @@index([accountId, contactedAt])
  @@index([salonId])
  @@map("contact_log")
  @@schema("bask")
}

/// Dealer-side coaching content. Global (no salon scope).
model Playbook {
  key              String   @id
  title            String
  category         String?
  targetSignalType String?  @map("target_signal_type")
  content          Json     @default("{}")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  contactLogs ContactLog[]

  @@map("playbook")
  @@schema("bask")
}

// ---------------------------------------------------------------------------
// Daybreak (pre-generated briefs)
// ---------------------------------------------------------------------------

/// Pre-generated morning briefs (IMPLEMENTATION_SPEC §0.1). The Today surface
/// reads a row here; it never waits on a model. `prompt_hash` is the cache key:
/// a rerun whose facts have not changed serves this row with no API call, which
/// is what makes the demo airplane-mode tolerant. `brief` holds the shape
/// defined by `daybreakBriefSchema` in packages/core.
model DaybreakBrief {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId     String   @map("salon_id") @db.Uuid
  forDate     DateTime @map("for_date") @db.Date
  promptHash  String   @map("prompt_hash")
  /// ai | cache | fallback — which path produced this brief.
  source      String   @default("fallback")
  model       String?
  brief       Json
  generatedAt DateTime @map("generated_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, forDate])
  @@index([salonId, forDate])
  @@map("daybreak_brief")
  @@schema("bask")
}

// ---------------------------------------------------------------------------
// The Floor: schedule, waivers, shift handoff (M1 lane 2)
// ---------------------------------------------------------------------------

/// A slot on the Floor schedule. Distinct from `Visit`, which is what actually
/// happened: a Booking is an intention, and the gap between the two is exactly
/// what a no-show is. `source` carries the walk-in / booked distinction the
/// schedule shades by, and `room_id` is nullable because a booking can be taken
/// against a service before anyone decides which bed it lands on.
model Booking {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId    String       @map("salon_id") @db.Uuid
  customerId String?      @map("customer_id") @db.Uuid
  serviceId  String?      @map("service_id") @db.Uuid
  roomId     String?      @map("room_id") @db.Uuid
  staffId    String?      @map("staff_id") @db.Uuid
  state      BookingState @default(booked)
  source     VisitSource  @default(online_booking)
  /// Set when a walk-in has no customer record yet.
  guestName  String?      @map("guest_name")
  startsAt   DateTime     @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime     @map("ends_at") @db.Timestamptz(6)
  minutes    Int
  notes      String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  room     Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  staff    Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([salonId, startsAt])
  @@index([customerId])
  @@map("booking")
  @@schema("bask")
}

/// A real signature, captured on a canvas at the front desk (DESIGN_SPEC §4
/// `SignaturePad`). `customer.waiver_signed_at` stays the fast flag the check-in
/// panel reads; this table is the artefact you can actually show someone.
/// `image_data` is a self-contained PNG data URL — no blob store to stand up for
/// a demo, and the row is portable.
model WaiverSignature {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId    String    @map("salon_id") @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  signedName String    @map("signed_name")
  imageData  String    @map("image_data")
  width      Int       @default(0)
  height     Int       @default(0)
  strokes    Int       @default(0)
  signedAt   DateTime  @default(now()) @map("signed_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  salon    Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([salonId, signedAt])
  @@index([customerId, signedAt])
  @@map("waiver_signature")
  @@schema("bask")
}

/// End-of-shift summary. `summary` is the computed snapshot frozen at post time —
/// the whole point of a handoff is that it says what the closer saw, not what the
/// numbers look like when the opener reads it tomorrow.
model ShiftHandoff {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId   String    @map("salon_id") @db.Uuid
  staffId   String?   @map("staff_id") @db.Uuid
  forDate   DateTime  @map("for_date") @db.Date
  summary   Json      @default("{}")
  note      String?
  postedAt  DateTime? @map("posted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  staff Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([salonId, forDate])
  @@map("shift_handoff")
  @@schema("bask")
}

// ---------------------------------------------------------------------------
// Demo harness
// ---------------------------------------------------------------------------

/// Singleton row (id = 'default'). The demo clock's `virtual_today` lives here
/// (IMPLEMENTATION_SPEC §1.4) — no timestamp rewriting, ever.
model DemoState {
  id                String    @id @default("default")
  virtualToday      DateTime  @map("virtual_today") @db.Date
  seed              String    @default("sunset-ridge-v1")
  lastAdvancedAt    DateTime? @map("last_advanced_at") @db.Timestamptz(6)
  lastPipelineRunAt DateTime? @map("last_pipeline_run_at") @db.Timestamptz(6)
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("demo_state")
  @@schema("bask")
}

/// Remote log sink (bootstrap skill Step 15c). Server actions, middleware and the
/// browser all POST here, so a failure during a live demo can be pulled from any
/// machine instead of being lost in a terminal nobody is watching.
model AppLog {
  id    BigInt   @id @default(autoincrement())
  ts    DateTime @default(now()) @db.Timestamptz(6)
  level String   @default("info")
  tag   String
  msg   String
  data  Json?

  @@index([ts])
  @@map("app_log")
  @@schema("bask")
}

/// One machine-extracted claim from the UVALUX audio corpus, awaiting or carrying
/// a human verdict. Spec: docs/superpowers/specs/2026-08-22-compass-knowledge-curation-design.md
///
/// NOT tenant-scoped: this is UVALUX's own training corpus, not salon data, so it
/// carries no salon_id and no RLS salon-isolation policy. It is internal-only and
/// never reaches a salon-facing surface.
///
/// `docId` points at bask.knowledge_doc, which is a RAW-SQL table (pgvector) and
/// therefore not a Prisma model — so this is a plain uuid with a database-level
/// foreign key added in the migration, not a Prisma relation. Null is meaningful:
/// it means no session could be matched, and it drives the `orphan` alert.
///
/// `quote` is NEVER empty. A claim without a verbatim quote is not a claim; the
/// loader refuses it and a CHECK constraint enforces it at the database boundary.
model KnowledgeClaim {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corpus         String
  claim          String
  quote          String
  category       String
  moment         String    @default("none")
  shape          String?
  specificity    String    @default("general")
  isScript       Boolean   @default(false) @map("is_script")
  sourceStream   String    @map("source_stream")
  sourceFile     String    @map("source_file")
  audioStreamIx  Int       @default(0) @map("audio_stream_ix")
  tStart         Float     @map("t_start")
  tEnd           Float     @map("t_end")
  docId          String?   @map("doc_id") @db.Uuid
  timesSaid      Int       @default(1) @map("times_said")
  distinctEvents Int       @default(1) @map("distinct_events")
  extractedBy    String    @map("extracted_by")
  lens           String    @default("advice")
  reviewState    String    @default("unreviewed") @map("review_state")
  reviewedBy     String?   @map("reviewed_by")
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNote     String?   @map("review_note")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  events KnowledgeClaimEvent[]

  @@unique([corpus, sourceStream, tStart, quote], map: "knowledge_claim_anchor_key")
  @@index([reviewState])
  @@index([lens, category])
  @@index([corpus])
  @@map("knowledge_claim")
  @@schema("bask")
}

/// Append-only audit of every curation decision.
///
/// Deliberately not columns on KnowledgeClaim: "who decided this was wrong, when,
/// and what did it say before" is the entire value of a curated corpus, and a
/// mutable row destroys it. It is also what makes undo trivial.
model KnowledgeClaimEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  claimId   String   @map("claim_id") @db.Uuid
  action    String
  actor     String
  before    Json?
  after     Json?
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  claim KnowledgeClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId, createdAt])
  @@map("knowledge_claim_event")
  @@schema("bask")
}
