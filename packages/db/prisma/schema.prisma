// Bask / Compass — schema v1 (M0 step 2).
//
// EVERY object lives in the dedicated Postgres schema `bask` on the SHARED CC&SS
// Supabase project. Nothing here may create, alter, drop or reference anything in
// `public` or any other app's schema (IMPLEMENTATION_SPEC §1.2). No foreign key
// crosses out of `bask`.
//
// Conventions:
//   - snake_case tables/columns via @map/@@map; PascalCase models.
//   - uuid primary keys generated by Postgres (gen_random_uuid()).
//   - every timestamp is timestamptz(6); date-only fields are `date`.
//   - every tenant-scoped table carries salon_id (org_id where it matters);
//     RLS + a salon-isolation policy are applied in the migration.
//   - money is numeric(10,2).
//   - state machines are enums (code-level); business taxonomies that must stay
//     extensible (room types, segments, playbooks) are lookup tables.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Connection URLs live in ../prisma.config.ts (Prisma 7 moved them out of the
// schema file). `schemas` is what pins every object to the `bask` namespace.
datasource db {
  provider = "postgresql"
  schemas  = ["bask"]
}

// ---------------------------------------------------------------------------
// Enums (state machines — not business taxonomies)
// ---------------------------------------------------------------------------

enum SalonStatus {
  onboarding
  active
  paused
  churned

  @@map("salon_status")
  @@schema("bask")
}

enum RoomState {
  ready
  in_session
  cleaning
  maintenance

  @@map("room_state")
  @@schema("bask")
}

enum SessionState {
  pending
  in_session
  cleaning
  completed
  cancelled
  faulted

  @@map("session_state")
  @@schema("bask")
}

enum SessionStartedBy {
  staff
  customer
  manual_equipment
  system

  @@map("session_started_by")
  @@schema("bask")
}

enum EquipmentDriverType {
  simulated
  tmax
  other

  @@map("equipment_driver_type")
  @@schema("bask")
}

enum CustomerStatus {
  active
  lapsed
  inactive

  @@map("customer_status")
  @@schema("bask")
}

enum MembershipStatus {
  active
  frozen
  cancelled

  @@map("membership_status")
  @@schema("bask")
}

enum PaymentState {
  current
  failed
  past_due
  recovered

  @@map("payment_state")
  @@schema("bask")
}

enum PackageStatus {
  active
  expired
  used
  refunded

  @@map("package_status")
  @@schema("bask")
}

enum VisitSource {
  walk_in
  appointment
  online_booking

  @@map("visit_source")
  @@schema("bask")
}

enum SaleState {
  completed
  voided
  refunded

  @@map("sale_state")
  @@schema("bask")
}

enum TenderType {
  cash
  card
  eft
  gift_card
  package_credit
  membership_included
  comp

  @@map("tender_type")
  @@schema("bask")
}

enum BarcodeSymbology {
  upc_a
  upc_e
  ean_13
  ean_8
  code_128
  qr
  custom

  @@map("barcode_symbology")
  @@schema("bask")
}

enum BarcodeSource {
  scanned
  manual
  printed_label
  catalog

  @@map("barcode_source")
  @@schema("bask")
}

enum StockEventType {
  received
  sold
  counted
  adjusted
  used_in_session

  @@map("stock_event_type")
  @@schema("bask")
}

enum InsightSeverity {
  info
  low
  medium
  high
  critical

  @@map("insight_severity")
  @@schema("bask")
}

enum InsightState {
  new
  seen
  actioned
  dismissed

  @@map("insight_state")
  @@schema("bask")
}

enum CampaignState {
  draft
  scheduled
  sent
  measured
  cancelled

  @@map("campaign_state")
  @@schema("bask")
}

enum GiftCardState {
  active
  redeemed
  expired
  void

  @@map("gift_card_state")
  @@schema("bask")
}

enum StaffRole {
  owner
  manager
  front_desk
  staff
  uvalux_rep
  uvalux_leadership

  @@map("staff_role")
  @@schema("bask")
}

enum ActorType {
  staff
  customer
  system

  @@map("actor_type")
  @@schema("bask")
}

enum ConsentTier {
  private
  benchmarks
  coaching

  @@map("consent_tier")
  @@schema("bask")
}

enum DraftOrderState {
  draft
  submitted
  acknowledged
  fulfilled
  cancelled

  @@map("draft_order_state")
  @@schema("bask")
}

enum AccountLifecycle {
  prospect
  new_opening
  established
  expansion
  at_risk
  churned

  @@map("account_lifecycle")
  @@schema("bask")
}

enum CoachingRequestState {
  open
  acknowledged
  in_progress
  closed

  @@map("coaching_request_state")
  @@schema("bask")
}

enum ContactChannel {
  call
  email
  text
  visit
  other

  @@map("contact_channel")
  @@schema("bask")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Org {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  salons Salon[]

  @@map("org")
  @@schema("bask")
}

model Salon {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String      @map("org_id") @db.Uuid
  name         String
  slug         String      @unique
  status       SalonStatus @default(active)
  addressLine1 String?     @map("address_line1")
  city         String?
  region       String?
  country      String      @default("CA")
  postalCode   String?     @map("postal_code")
  phone        String?
  email        String?
  timezone     String      @default("America/Vancouver")
  logoUrl      String?     @map("logo_url")
  theme        String      @default("sunset")
  openedAt     DateTime?   @map("opened_at") @db.Timestamptz(6)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  org               Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rooms             Room[]
  equipmentDevices  EquipmentDevice[]
  services          Service[]
  sessions          Session[]
  customers         Customer[]
  memberships       Membership[]
  packages          Package[]
  visits            Visit[]
  sales             Sale[]
  saleLines         SaleLine[]
  products          Product[]
  barcodes          Barcode[]
  inventoryLevels   InventoryLevel[]
  stockEvents       StockEvent[]
  insights          Insight[]
  campaigns         Campaign[]
  giftCards         GiftCard[]
  activityEvents    ActivityEvent[]
  staff             Staff[]
  consentProfile    ConsentProfile?
  consentAudit      ConsentAuditEntry[]
  draftOrders       DraftOrder[]
  account           Account?
  signalSnapshots   SignalSnapshot[]
  coachingRequests  CoachingRequest[]
  contactLogs       ContactLog[]

  @@index([orgId])
  @@map("salon")
  @@schema("bask")
}

model Staff {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId      String?   @map("salon_id") @db.Uuid // null = UVALUX-side (rep / leadership)
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  email        String?
  phone        String?
  role         StaffRole @default(staff)
  permissions  Json      @default("{}")
  shiftPattern Json      @default("{}") @map("shift_pattern")
  isActive     Boolean   @default(true) @map("is_active")
  hiredAt      DateTime? @map("hired_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon                Salon?              @relation(fields: [salonId], references: [id], onDelete: Cascade)
  sessionsStarted      Session[]           @relation("SessionStartedByStaff")
  visits               Visit[]
  sales                Sale[]
  saleLines            SaleLine[]
  stockEvents          StockEvent[]
  campaignsCreated     Campaign[]
  activityEvents       ActivityEvent[]
  consentChanges       ConsentAuditEntry[]
  consentProfiles      ConsentProfile[]
  draftOrdersCreated   DraftOrder[]
  accountsAssigned     Account[]           @relation("AccountAssignedRep")
  coachingRequested    CoachingRequest[]   @relation("CoachingRequestedBy")
  coachingAssigned     CoachingRequest[]   @relation("CoachingAssignedRep")
  contactLogs          ContactLog[]

  @@index([salonId])
  @@index([role])
  @@map("staff")
  @@schema("bask")
}

// ---------------------------------------------------------------------------
// Rooms, equipment, sessions
// ---------------------------------------------------------------------------

/// Extensible lookup — NOT a hard enum. Wellness expansion adds rows, not migrations.
model RoomType {
  key            String   @id
  label          String
  category       String   @default("uv") // uv | spray | wellness
  defaultMinutes Int      @default(12) @map("default_minutes")
  cleaningMinutes Int     @default(5) @map("cleaning_minutes")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rooms    Room[]
  services Service[]

  @@map("room_type")
  @@schema("bask")
}

model Room {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId         String    @map("salon_id") @db.Uuid
  roomTypeKey     String    @map("room_type_key")
  name            String
  state           RoomState @default(ready)
  maintenanceNote String?   @map("maintenance_note")
  cleaningMinutes Int       @default(5) @map("cleaning_minutes")
  sortOrder       Int       @default(0) @map("sort_order")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon           Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  roomType        RoomType         @relation(fields: [roomTypeKey], references: [key])
  sessions        Session[]
  equipmentDevice EquipmentDevice?

  @@unique([salonId, name])
  @@index([salonId])
  @@map("room")
  @@schema("bask")
}

/// Exists from M0 so hardware (M4) lands without a migration (IMPLEMENTATION_SPEC §5.2).
model EquipmentDevice {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId    String              @map("salon_id") @db.Uuid
  roomId     String              @unique @map("room_id") @db.Uuid
  driverType EquipmentDriverType @default(simulated) @map("driver_type")
  address    String // bus address / unit id / host:port, driver-specific
  config     Json                @default("{}")
  status     String              @default("idle") // idle | delay | running | cooldown | fault | offline
  lastSeenAt DateTime?           @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
  room  Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([salonId])
  @@map("equipment_device")
  @@schema("bask")
}

model Service {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId         String   @map("salon_id") @db.Uuid
  name            String
  category        String   @default("uv")
  roomTypeKey     String?  @map("room_type_key")
  durationMinutes Int      @map("duration_minutes")
  price           Decimal  @default(0) @db.Decimal(10, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon     Salon      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  roomType  RoomType?  @relation(fields: [roomTypeKey], references: [key])
  sessions  Session[]
  packages  Package[]
  saleLines SaleLine[]

  @@unique([salonId, name])
  @@index([salonId])
  @@map("service")
  @@schema("bask")
}

model Session {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId          String           @map("salon_id") @db.Uuid
  roomId           String           @map("room_id") @db.Uuid
  customerId       String?          @map("customer_id") @db.Uuid
  serviceId        String?          @map("service_id") @db.Uuid
  visitId          String?          @map("visit_id") @db.Uuid
  startedByStaffId String?          @map("started_by_staff_id") @db.Uuid
  startedBy        SessionStartedBy @default(staff) @map("started_by")
  state            SessionState     @default(pending)
  requestedMinutes Int              @map("requested_minutes")
  equipmentMinutes Int?             @map("equipment_minutes")
  delayMinutes     Int              @default(0) @map("delay_minutes")
  startedAt        DateTime?        @map("started_at") @db.Timestamptz(6)
  endsAt           DateTime?        @map("ends_at") @db.Timestamptz(6)
  endedAt          DateTime?        @map("ended_at") @db.Timestamptz(6)
  cleaningEndsAt   DateTime?        @map("cleaning_ends_at") @db.Timestamptz(6)
  notes            String?
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon          Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  room           Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  service        Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  visit          Visit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)
  startedByStaff Staff?       @relation("SessionStartedByStaff", fields: [startedByStaffId], references: [id], onDelete: SetNull)
  stockEvents    StockEvent[]

  @@index([salonId, startedAt])
  @@index([roomId, state])
  @@index([customerId])
  @@map("session")
  @@schema("bask")
}

// ---------------------------------------------------------------------------
// Customers, memberships, packages, visits, sales
// ---------------------------------------------------------------------------

model Customer {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId               String         @map("salon_id") @db.Uuid
  firstName             String         @map("first_name")
  lastName              String         @map("last_name")
  email                 String?
  phone                 String?
  birthDate             DateTime?      @map("birth_date") @db.Date
  photoUrl              String?        @map("photo_url")
  skinType              String?        @map("skin_type")
  status                CustomerStatus @default(active)
  // consent flags
  emailOptIn            Boolean        @default(false) @map("email_opt_in")
  smsOptIn              Boolean        @default(false) @map("sms_opt_in")
  photoConsent          Boolean        @default(false) @map("photo_consent")
  marketingConsentAt    DateTime?      @map("marketing_consent_at") @db.Timestamptz(6)
  waiverSignedAt        DateTime?      @map("waiver_signed_at") @db.Timestamptz(6)
  notes                 String?
  joinedAt              DateTime       @default(now()) @map("joined_at") @db.Timestamptz(6)
  lastVisitAt           DateTime?      @map("last_visit_at") @db.Timestamptz(6)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon             Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  memberships       Membership[]
  packages          Package[]
  visits            Visit[]
  sessions          Session[]
  sales             Sale[]
  saleLines         SaleLine[]
  giftCardsBought   GiftCard[]   @relation("GiftCardPurchaser")
  giftCardsReceived GiftCard[]   @relation("GiftCardRecipient")

  @@index([salonId, lastName])
  @@index([salonId, status])
  @@index([salonId, email])
  @@map("customer")
  @@schema("bask")
}

model Membership {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId            String           @map("salon_id") @db.Uuid
  customerId         String           @map("customer_id") @db.Uuid
  tier               String // bronze | silver | gold — salon-defined
  status             MembershipStatus @default(active)
  paymentState       PaymentState     @default(current) @map("payment_state")
  monthlyPrice       Decimal          @default(0) @map("monthly_price") @db.Decimal(10, 2)
  billingDayOfMonth  Int              @default(1) @map("billing_day_of_month")
  startedAt          DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  nextBillingAt      DateTime?        @map("next_billing_at") @db.Timestamptz(6)
  lastPaymentAt      DateTime?        @map("last_payment_at") @db.Timestamptz(6)
  failedPaymentCount Int              @default(0) @map("failed_payment_count")
  frozenAt           DateTime?        @map("frozen_at") @db.Timestamptz(6)
  cancelledAt        DateTime?        @map("cancelled_at") @db.Timestamptz(6)
  cancelReason       String?          @map("cancel_reason")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon    Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([salonId, status])
  @@index([salonId, paymentState])
  @@index([customerId])
  @@map("membership")
  @@schema("bask")
}

model Package {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId          String        @map("salon_id") @db.Uuid
  customerId       String        @map("customer_id") @db.Uuid
  serviceId        String?       @map("service_id") @db.Uuid
  name             String
  creditsTotal     Int           @map("credits_total")
  creditsRemaining Int           @map("credits_remaining")
  status           PackageStatus @default(active)
  pricePaid        Decimal       @default(0) @map("price_paid") @db.Decimal(10, 2)
  purchasedAt      DateTime      @default(now()) @map("purchased_at") @db.Timestamptz(6)
  expiresAt        DateTime?     @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon    Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([salonId, status])
  @@index([customerId])
  @@map("package")
  @@schema("bask")
}

model Visit {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId      String      @map("salon_id") @db.Uuid
  customerId   String      @map("customer_id") @db.Uuid
  staffId      String?     @map("staff_id") @db.Uuid
  source       VisitSource @default(walk_in)
  checkedInAt  DateTime    @default(now()) @map("checked_in_at") @db.Timestamptz(6)
  checkedOutAt DateTime?   @map("checked_out_at") @db.Timestamptz(6)
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff    Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  sessions Session[]
  sales    Sale[]

  @@index([salonId, checkedInAt])
  @@index([customerId])
  @@map("visit")
  @@schema("bask")
}

model Sale {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId    String    @map("salon_id") @db.Uuid
  visitId    String?   @map("visit_id") @db.Uuid
  customerId String?   @map("customer_id") @db.Uuid
  staffId    String?   @map("staff_id") @db.Uuid
  state      SaleState @default(completed)
  subtotal   Decimal   @default(0) @db.Decimal(10, 2)
  discount   Decimal   @default(0) @db.Decimal(10, 2)
  tax        Decimal   @default(0) @db.Decimal(10, 2)
  total      Decimal   @default(0) @db.Decimal(10, 2)
  soldAt     DateTime  @default(now()) @map("sold_at") @db.Timestamptz(6)
  voidedAt   DateTime? @map("voided_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  salon    Salon      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  visit    Visit?     @relation(fields: [visitId], references: [id], onDelete: SetNull)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  staff    Staff?     @relation(fields: [staffId], references: [id], onDelete: SetNull)
  lines    SaleLine[]

  @@index([salonId, soldAt])
  @@index([customerId])
  @@map("sale")
  @@schema("bask")
}

/// The per-customer product-tracking spine (IMPLEMENTATION_SPEC §2).
model SaleLine {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId    String     @map("salon_id") @db.Uuid
  saleId     String     @map("sale_id") @db.Uuid
  customerId String?    @map("customer_id") @db.Uuid
  productId  String?    @map("product_id") @db.Uuid
  serviceId  String?    @map("service_id") @db.Uuid
  giftCardId String?    @map("gift_card_id") @db.Uuid
  staffId    String?    @map("staff_id") @db.Uuid
  quantity   Int        @default(1)
  unitPrice  Decimal    @default(0) @map("unit_price") @db.Decimal(10, 2)
  discount   Decimal    @default(0) @db.Decimal(10, 2)
  lineTotal  Decimal    @default(0) @map("line_total") @db.Decimal(10, 2)
  tenderType TenderType @default(card) @map("tender_type")
  soldAt     DateTime   @default(now()) @map("sold_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  sale     Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  giftCard GiftCard? @relation(fields: [giftCardId], references: [id], onDelete: SetNull)
  staff    Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([salonId, soldAt])
  @@index([productId])
  @@index([customerId, productId])
  @@map("sale_line")
  @@schema("bask")
}

// ---------------------------------------------------------------------------
// Products, barcodes, catalogue, inventory
// ---------------------------------------------------------------------------

/// Seeded plausible UVALUX catalogue; real catalogue import lands M3+. Global (no salon).
model UvaluxCatalogItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officialSku   String?  @unique @map("official_sku")
  name          String
  brand         String?
  category      String?
  size          String?
  upc           String?
  wholesalePrice Decimal? @map("wholesale_price") @db.Decimal(10, 2)
  msrp          Decimal? @db.Decimal(10, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products        Product[]
  draftOrderLines DraftOrderLine[]

  @@map("uvalux_catalog_item")
  @@schema("bask")
}

/// Internal SKU `BSK-#####`. salon_id null = catalogue-wide product; set = salon-custom.
model Product {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId             String?  @map("salon_id") @db.Uuid
  sku                 String   @unique
  name                String
  brand               String?
  category            String?
  size                String?
  retailPrice         Decimal  @default(0) @map("retail_price") @db.Decimal(10, 2)
  wholesaleCost       Decimal? @map("wholesale_cost") @db.Decimal(10, 2)
  uvaluxCatalogItemId String?  @map("uvalux_catalog_item_id") @db.Uuid
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon             Salon?             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  uvaluxCatalogItem UvaluxCatalogItem? @relation(fields: [uvaluxCatalogItemId], references: [id], onDelete: SetNull)
  barcodes          Barcode[]
  inventoryLevels   InventoryLevel[]
  stockEvents       StockEvent[]
  saleLines         SaleLine[]
  draftOrderLines   DraftOrderLine[]

  @@index([salonId])
  @@index([category])
  @@map("product")
  @@schema("bask")
}

/// Many external codes → one product (manufacturer UPC/EAN + self-printed Code128).
model Barcode {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId    String?          @map("salon_id") @db.Uuid
  productId  String           @map("product_id") @db.Uuid
  value      String
  symbology  BarcodeSymbology @default(upc_a)
  source     BarcodeSource    @default(scanned)
  isPrimary  Boolean          @default(false) @map("is_primary")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  salon   Salon?  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, value])
  @@index([value])
  @@index([salonId])
  @@map("barcode")
  @@schema("bask")
}

model InventoryLevel {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId       String    @map("salon_id") @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  onHand        Int       @default(0) @map("on_hand")
  reorderPoint  Int       @default(0) @map("reorder_point")
  parLevel      Int?      @map("par_level")
  lastCountedAt DateTime? @map("last_counted_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon   Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([salonId, productId])
  @@index([salonId])
  @@map("inventory_level")
  @@schema("bask")
}

/// Sell-through and days-remaining are computed from events, never stored as truth.
model StockEvent {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId       String         @map("salon_id") @db.Uuid
  productId     String         @map("product_id") @db.Uuid
  type          StockEventType
  quantityDelta Int            @map("quantity_delta")
  quantityAfter Int?           @map("quantity_after")
  unitCost      Decimal?       @map("unit_cost") @db.Decimal(10, 2)
  staffId       String?        @map("staff_id") @db.Uuid
  sessionId     String?        @map("session_id") @db.Uuid
  saleLineId    String?        @map("sale_line_id") @db.Uuid
  note          String?
  occurredAt    DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)

  salon   Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  staff   Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([salonId, occurredAt])
  @@index([productId, occurredAt])
  @@map("stock_event")
  @@schema("bask")
}

// ---------------------------------------------------------------------------
// Insights, marketing, gift cards, activity
// ---------------------------------------------------------------------------

/// `evidence` holds the ONE typed Evidence shape defined in packages/core (M0 step 5).
model Insight {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId          String          @map("salon_id") @db.Uuid
  type             String // retail_attachment_slip | failed_payments | soft_capacity | low_stock | overstock | anomaly | ...
  severity         InsightSeverity @default(medium)
  title            String
  summary          String?
  impactEstimate   Decimal?        @map("impact_estimate") @db.Decimal(10, 2)
  impactCurrency   String          @default("CAD") @map("impact_currency")
  evidence         Json            @default("{}")
  state            InsightState    @default(new)
  dismissReason    String?         @map("dismiss_reason")
  linkedActionType String?         @map("linked_action_type") // create_campaign | draft_order | open_heatmap | recover_payment | ...
  linkedActionRef  Json?           @map("linked_action_ref")
  outcome          Json?
  forDate          DateTime        @map("for_date") @db.Date
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  seenAt           DateTime?       @map("seen_at") @db.Timestamptz(6)
  actionedAt       DateTime?       @map("actioned_at") @db.Timestamptz(6)
  dismissedAt      DateTime?       @map("dismissed_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon     Salon      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([salonId, state])
  @@index([salonId, forDate])
  @@index([type])
  @@map("insight")
  @@schema("bask")
}

/// Fixed coded predicates — a KEY, never a stored query AST (IMPLEMENTATION_SPEC §2).
model Segment {
  key         String   @id // new_this_month | expiring_packages | at_risk | big_spenders | lapsed_30d | midweek_regulars
  label       String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  campaigns Campaign[]

  @@map("segment")
  @@schema("bask")
}

model Campaign {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId            String        @map("salon_id") @db.Uuid
  name               String
  goal               String?
  segmentKey         String?       @map("segment_key")
  segmentSnapshot    Json          @default("{}") @map("segment_snapshot")
  channels           String[]      @default([])
  content            Json          @default("{}")
  state              CampaignState @default(draft)
  scheduledFor       DateTime?     @map("scheduled_for") @db.Timestamptz(6)
  sentAt             DateTime?     @map("sent_at") @db.Timestamptz(6)
  measuredAt         DateTime?     @map("measured_at") @db.Timestamptz(6)
  results            Json?
  sourceInsightId    String?       @map("source_insight_id") @db.Uuid
  createdByStaffId   String?       @map("created_by_staff_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon         Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  segment       Segment? @relation(fields: [segmentKey], references: [key])
  sourceInsight Insight? @relation(fields: [sourceInsightId], references: [id], onDelete: SetNull)
  createdBy     Staff?   @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)

  @@index([salonId, state])
  @@map("campaign")
  @@schema("bask")
}

model GiftCard {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId        String        @map("salon_id") @db.Uuid
  code           String        @unique
  initialBalance Decimal       @default(0) @map("initial_balance") @db.Decimal(10, 2)
  balance        Decimal       @default(0) @db.Decimal(10, 2)
  state          GiftCardState @default(active)
  purchaserId    String?       @map("purchaser_id") @db.Uuid
  recipientId    String?       @map("recipient_id") @db.Uuid
  recipientName  String?       @map("recipient_name")
  recipientEmail String?       @map("recipient_email")
  issuedAt       DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt      DateTime?     @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon     Salon      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  purchaser Customer?  @relation("GiftCardPurchaser", fields: [purchaserId], references: [id], onDelete: SetNull)
  recipient Customer?  @relation("GiftCardRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  saleLines SaleLine[]

  @@index([salonId, state])
  @@map("gift_card")
  @@schema("bask")
}

/// Owner-facing activity log: discounts, voids, refunds, insight dismissals,
/// consent changes, campaign sends.
model ActivityEvent {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId      String    @map("salon_id") @db.Uuid
  actorType    ActorType @default(staff) @map("actor_type")
  actorStaffId String?   @map("actor_staff_id") @db.Uuid
  actorLabel   String?   @map("actor_label")
  action       String
  targetType   String?   @map("target_type")
  targetId     String?   @map("target_id") @db.Uuid
  metadata     Json      @default("{}")
  occurredAt   DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)

  salon      Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  actorStaff Staff? @relation(fields: [actorStaffId], references: [id], onDelete: SetNull)

  @@index([salonId, occurredAt])
  @@index([targetType, targetId])
  @@map("activity_event")
  @@schema("bask")
}

// ---------------------------------------------------------------------------
// Consent (the choke point Compass reads through)
// ---------------------------------------------------------------------------

model ConsentProfile {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId         String      @unique @map("salon_id") @db.Uuid
  tier            ConsentTier @default(benchmarks)
  updatedByStaffId String?    @map("updated_by_staff_id") @db.Uuid
  effectiveAt     DateTime    @default(now()) @map("effective_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon           Salon               @relation(fields: [salonId], references: [id], onDelete: Cascade)
  updatedByStaff  Staff?              @relation(fields: [updatedByStaffId], references: [id], onDelete: SetNull)
  auditEntries    ConsentAuditEntry[]

  @@map("consent_profile")
  @@schema("bask")
}

model ConsentAuditEntry {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId          String       @map("salon_id") @db.Uuid
  consentProfileId String       @map("consent_profile_id") @db.Uuid
  fromTier         ConsentTier? @map("from_tier")
  toTier           ConsentTier  @map("to_tier")
  changedByStaffId String?      @map("changed_by_staff_id") @db.Uuid
  note             String?
  changedAt        DateTime     @default(now()) @map("changed_at") @db.Timestamptz(6)

  salon          Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  consentProfile ConsentProfile @relation(fields: [consentProfileId], references: [id], onDelete: Cascade)
  changedByStaff Staff?         @relation(fields: [changedByStaffId], references: [id], onDelete: SetNull)

  @@index([salonId, changedAt])
  @@map("consent_audit_entry")
  @@schema("bask")
}

// ---------------------------------------------------------------------------
// Ordering (salon → UVALUX), surfaces in Compass AccountTimeline
// ---------------------------------------------------------------------------

model DraftOrder {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId          String          @map("salon_id") @db.Uuid
  accountId        String?         @map("account_id") @db.Uuid
  state            DraftOrderState @default(draft)
  total            Decimal         @default(0) @db.Decimal(10, 2)
  note             String?
  createdByStaffId String?         @map("created_by_staff_id") @db.Uuid
  submittedAt      DateTime?       @map("submitted_at") @db.Timestamptz(6)
  acknowledgedAt   DateTime?       @map("acknowledged_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon     Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  account   Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy Staff?           @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)
  lines     DraftOrderLine[]

  @@index([salonId, state])
  @@map("draft_order")
  @@schema("bask")
}

model DraftOrderLine {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draftOrderId        String   @map("draft_order_id") @db.Uuid
  productId           String?  @map("product_id") @db.Uuid
  uvaluxCatalogItemId String?  @map("uvalux_catalog_item_id") @db.Uuid
  description         String?
  quantity            Int      @default(1)
  unitPrice           Decimal  @default(0) @map("unit_price") @db.Decimal(10, 2)
  /// Why this line is on the order — shown to the rep in Compass.
  reason              String?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  draftOrder        DraftOrder         @relation(fields: [draftOrderId], references: [id], onDelete: Cascade)
  product           Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  uvaluxCatalogItem UvaluxCatalogItem? @relation(fields: [uvaluxCatalogItemId], references: [id], onDelete: SetNull)

  @@index([draftOrderId])
  @@map("draft_order_line")
  @@schema("bask")
}

// ---------------------------------------------------------------------------
// Compass (dealer side) — reads salon data only through packages/core/consent.ts
// ---------------------------------------------------------------------------

model Account {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId              String           @unique @map("salon_id") @db.Uuid
  accountNumber        String?          @unique @map("account_number")
  lifecycle            AccountLifecycle @default(established)
  healthScore          Int?             @map("health_score")
  annualWholesaleValue Decimal?         @map("annual_wholesale_value") @db.Decimal(12, 2)
  territory            String?
  assignedRepId        String?          @map("assigned_rep_id") @db.Uuid
  lastContactAt        DateTime?        @map("last_contact_at") @db.Timestamptz(6)
  nextTouchAt          DateTime?        @map("next_touch_at") @db.Timestamptz(6)
  metadata             Json             @default("{}")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon            Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  assignedRep      Staff?            @relation("AccountAssignedRep", fields: [assignedRepId], references: [id], onDelete: SetNull)
  signalSnapshots  SignalSnapshot[]
  coachingRequests CoachingRequest[]
  contactLogs      ContactLog[]
  draftOrders      DraftOrder[]

  @@index([lifecycle])
  @@index([assignedRepId])
  @@map("account")
  @@schema("bask")
}

model SignalSnapshot {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String          @map("account_id") @db.Uuid
  salonId    String          @map("salon_id") @db.Uuid
  signalType String          @map("signal_type")
  severity   InsightSeverity @default(medium)
  headline   String
  metrics    Json            @default("{}")
  evidence   Json            @default("{}")
  forDate    DateTime        @map("for_date") @db.Date
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  salon   Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([accountId, forDate])
  @@index([salonId])
  @@map("signal_snapshot")
  @@schema("bask")
}

model CoachingRequest {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId           String               @map("salon_id") @db.Uuid
  accountId         String               @map("account_id") @db.Uuid
  topic             String
  message           String?
  state             CoachingRequestState @default(open)
  requestedByStaffId String?             @map("requested_by_staff_id") @db.Uuid
  assignedRepId     String?              @map("assigned_rep_id") @db.Uuid
  response          String?
  requestedAt       DateTime             @default(now()) @map("requested_at") @db.Timestamptz(6)
  respondedAt       DateTime?            @map("responded_at") @db.Timestamptz(6)
  closedAt          DateTime?            @map("closed_at") @db.Timestamptz(6)

  salon          Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  account        Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  requestedBy    Staff?  @relation("CoachingRequestedBy", fields: [requestedByStaffId], references: [id], onDelete: SetNull)
  assignedRep    Staff?  @relation("CoachingAssignedRep", fields: [assignedRepId], references: [id], onDelete: SetNull)

  @@index([salonId, state])
  @@index([accountId, state])
  @@map("coaching_request")
  @@schema("bask")
}

model ContactLog {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId       String         @map("account_id") @db.Uuid
  salonId         String         @map("salon_id") @db.Uuid
  repId           String?        @map("rep_id") @db.Uuid
  channel         ContactChannel @default(call)
  outcome         String?
  notes           String?
  playbookKey     String?        @map("playbook_key")
  durationMinutes Int?           @map("duration_minutes")
  contactedAt     DateTime       @default(now()) @map("contacted_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  rep      Staff?    @relation(fields: [repId], references: [id], onDelete: SetNull)
  playbook Playbook? @relation(fields: [playbookKey], references: [key])

  @@index([accountId, contactedAt])
  @@index([salonId])
  @@map("contact_log")
  @@schema("bask")
}

/// Dealer-side coaching content. Global (no salon scope).
model Playbook {
  key              String   @id
  title            String
  category         String?
  targetSignalType String?  @map("target_signal_type")
  content          Json     @default("{}")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  contactLogs ContactLog[]

  @@map("playbook")
  @@schema("bask")
}

// ---------------------------------------------------------------------------
// Demo harness
// ---------------------------------------------------------------------------

/// Singleton row (id = 'default'). The demo clock's `virtual_today` lives here
/// (IMPLEMENTATION_SPEC §1.4) — no timestamp rewriting, ever.
model DemoState {
  id                String   @id @default("default")
  virtualToday      DateTime @map("virtual_today") @db.Date
  seed              String   @default("sunset-ridge-v1")
  lastAdvancedAt    DateTime? @map("last_advanced_at") @db.Timestamptz(6)
  lastPipelineRunAt DateTime? @map("last_pipeline_run_at") @db.Timestamptz(6)
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("demo_state")
  @@schema("bask")
}
